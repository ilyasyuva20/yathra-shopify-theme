{%- comment -%} Yathra · Thread homepage section {%- endcomment -%}
{{ 'https://fonts.googleapis.com/css2?family=Noto+Sans+Malayalam:wght@600&display=swap' | stylesheet_tag }}
{%- assign s = section.settings -%}
<style>
  {{ s.heading_font | font_face: font_display: 'swap' }}
  {{ s.body_font | font_face: font_display: 'swap' }}
  {%- assign body_bold = s.body_font | font_modify: 'weight', 'bold' -%}{{ body_bold | font_face: font_display: 'swap' }}
  #yt-{{ section.id }}{--sky:{{ s.sky }};--sindoor:{{ s.red }};--turmeric:#F7B500;--rani:#C81D6B;--leaf:#13804F;--ink:{{ s.ink }};--white:#FFFFFF;
    --hf:{{ s.heading_font.family }},{{ s.heading_font.fallback_families }};--hw:{{ s.heading_font.weight }};
    font-family:{{ s.body_font.family }},{{ s.body_font.fallback_families }};font-size:16px;line-height:1.6;color:var(--ink);background:var(--white);overflow:hidden}
  #yt-{{ section.id }} *{box-sizing:border-box}
  #yt-{{ section.id }} a{color:inherit;text-decoration:none}
  #yt-{{ section.id }} img{display:block;width:100%;height:100%;object-fit:cover}
  #yt-{{ section.id }} :focus-visible{outline:3px solid var(--ink);outline-offset:3px}
  .yt-wrap{max-width:1360px;margin:0 auto;padding:0 32px}
  #yt-{{ section.id }} .yt-display{font-family:var(--hf);color:inherit;font-weight:var(--hw);letter-spacing:0;line-height:1.15}

  /* Hero */
  .yt-hero{position:relative;background:var(--sky);min-height:560px;isolation:isolate}
  .yt-thread{position:absolute;inset:0;width:100%;height:100%;z-index:1;pointer-events:none}
  .yt-thread path{fill:none;stroke-linecap:round;stroke-linejoin:round}
  .yt-thread .t-main{stroke:#fff;stroke-opacity:.55;stroke-width:12;stroke-dasharray:1;stroke-dashoffset:1;animation:yt-draw 2.6s cubic-bezier(.6,.1,.3,1) .2s forwards}
  .yt-thread .t-red{stroke:var(--sindoor);stroke-width:12;stroke-dasharray:1;stroke-dashoffset:1;animation:yt-draw .7s ease-out 2.5s forwards}
  @keyframes yt-draw{to{stroke-dashoffset:0}}
  .yt-hero__in{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:40px;align-items:center;padding-top:72px;padding-bottom:88px}
  #yt-{{ section.id }} .yt-h1{margin:0;font-size:clamp(32px,3.6vw,52px);overflow-wrap:normal;word-break:keep-all;hyphens:none}
  .yt-sticker{display:inline-block;margin-top:26px;background:#fff;color:var(--sindoor);font-family:'Noto Sans Malayalam',sans-serif;font-weight:600;font-size:clamp(18px,1.8vw,22px);line-height:1.4;padding:6px 14px;border-radius:4px;transform:rotate(-3deg) scale(.6);opacity:0;animation:yt-pop .5s cubic-bezier(.3,1.6,.5,1) 2.9s forwards;box-shadow:0 6px 0 rgba(19,35,58,.18)}
  @keyframes yt-pop{to{opacity:1;transform:rotate(-3deg) scale(1)}}
  .yt-lead{margin:18px 0 0;font-size:17px;line-height:1.6;max-width:34em}
  .yt-ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
  .yt-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 24px;border-radius:8px;font-weight:600;font-size:15px;border:2px solid var(--ink);transition:transform .15s ease}
  .yt-btn:active{transform:scale(.97)}
  #yt-{{ section.id }} .yt-btn--ink{background:var(--ink);color:#fff !important}
  #yt-{{ section.id }} .yt-btn--ghost{background:transparent;color:var(--ink) !important}
  #yt-{{ section.id }} .yt-btn--leaf{background:var(--leaf);border-color:var(--leaf);color:#fff !important}
  .yt-fan{position:relative;height:480px}
  .yt-print{position:absolute;width:47%;aspect-ratio:3/4.4;background:#fff;padding:7px;border-radius:6px;box-shadow:0 22px 44px rgba(19,35,58,.28);opacity:0;animation:yt-drop .8s cubic-bezier(.2,.9,.3,1.2) forwards}
  .yt-print span{display:block;width:100%;height:100%;overflow:hidden;border-radius:3px}
  .yt-print:nth-child(1){left:0;top:70px;--r:-8deg;animation-delay:1.1s}
  .yt-print:nth-child(2){left:27%;top:0;--r:2deg;z-index:2;animation-delay:1.35s}
  .yt-print:nth-child(3){right:0;top:96px;--r:9deg;animation-delay:1.6s}
  @keyframes yt-drop{from{opacity:0;transform:translateY(-40px) rotate(0)}to{opacity:1;transform:translateY(0) rotate(var(--r))}}

  /* Shelves */
  .yt-shelves{padding:72px 0 0}
  #yt-{{ section.id }} .yt-h2{margin:0;font-size:clamp(26px,2.6vw,36px)}
  .yt-shelfhead{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:16px;margin-bottom:28px}
  .yt-shelfhead p{margin:0;font-size:15px;max-width:30em;line-height:1.5}
  .yt-shelf{position:relative;display:flex;align-items:center;justify-content:space-between;gap:24px;height:92px;padding:0 32px;overflow:hidden;transition:height .35s cubic-bezier(.3,.8,.3,1)}
  .yt-shelf__name{font-size:clamp(24px,2.6vw,36px);position:relative;z-index:1}
  .yt-shelf__text{font-size:15px;font-weight:500;position:relative;z-index:1;max-width:22em;text-align:right;margin-right:200px;transition:margin .35s}
  .yt-shelf__img{position:absolute;right:32px;top:12px;width:140px;height:176px;border-radius:6px;overflow:hidden;transform:translateY(40px) rotate(6deg);transition:transform .35s cubic-bezier(.3,.8,.3,1);box-shadow:0 12px 30px rgba(0,0,0,.25)}
  .yt-shelf:hover,.yt-shelf:focus-visible{height:200px}
  .yt-shelf:hover .yt-shelf__img,.yt-shelf:focus-visible .yt-shelf__img{transform:translateY(0) rotate(3deg)}
  {%- assign br = s.shelf1_color | color_brightness -%}
  #yt-{{ section.id }} .yt-shelf:nth-child(1){background:{{ s.shelf1_color }};color:{% if br > 150 %}var(--ink){% else %}#fff{% endif %}}
  {%- assign br = s.shelf2_color | color_brightness -%}
  #yt-{{ section.id }} .yt-shelf:nth-child(2){background:{{ s.shelf2_color }};color:{% if br > 150 %}var(--ink){% else %}#fff{% endif %}}
  {%- assign br = s.shelf3_color | color_brightness -%}
  #yt-{{ section.id }} .yt-shelf:nth-child(3){background:{{ s.shelf3_color }};color:{% if br > 150 %}var(--ink){% else %}#fff{% endif %}}
  {%- assign br = s.shelf4_color | color_brightness -%}
  #yt-{{ section.id }} .yt-shelf:nth-child(4){background:{{ s.shelf4_color }};color:{% if br > 150 %}var(--ink){% else %}#fff{% endif %}}
  {%- assign br = s.shelf5_color | color_brightness -%}
  #yt-{{ section.id }} .yt-shelf:nth-child(5){background:{{ s.shelf5_color }};color:{% if br > 150 %}var(--ink){% else %}#fff{% endif %}}

  /* Reels */
  .yt-reels{background:var(--ink);color:#fff;padding:64px 0 80px;margin-top:0}
  .yt-reels__head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:16px;margin-bottom:36px}
  #yt-{{ section.id }} .yt-reels__head a{font-weight:600;font-size:15px;color:#fff !important;border-bottom:2px solid currentColor;padding-bottom:2px}
  .yt-track{display:flex;gap:18px;width:max-content;animation:yt-scroll 48s linear infinite}
  .yt-reels:hover .yt-track{animation-play-state:paused}
  .yt-reel{width:250px;aspect-ratio:3/4;border-radius:10px;overflow:hidden;flex:0 0 auto;background:#22344d}
  #yt-{{ section.id }} .yt-reel img{object-position:50% 12%}
  .yt-reel:nth-child(odd){transform:translateY(22px)}
  @keyframes yt-scroll{to{transform:translateX(-50%)}}

  /* Products */
  .yt-products{padding:72px 0 24px}
  .yt-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:40px 24px;margin-top:40px}
  .yt-card{position:relative;display:flex;flex-direction:column;gap:8px}
  .yt-card__img{position:relative;display:block;aspect-ratio:3/4;border-radius:6px;overflow:hidden;background:#EAF4FB}
  .yt-tag{position:absolute;top:16px;right:14px;z-index:2;background:var(--turmeric);color:var(--ink);font-weight:700;font-size:15px;padding:14px 12px 8px;border-radius:6px 6px 10px 10px;transform-origin:50% 0;transform:rotate(5deg);box-shadow:0 6px 14px rgba(19,35,58,.22)}
  .yt-tag::before{content:"";position:absolute;top:6px;left:50%;width:7px;height:7px;margin-left:-3.5px;border-radius:50%;background:#fff}
  .yt-card:hover .yt-tag{animation:yt-swing .9s ease-in-out}
  @keyframes yt-swing{0%{transform:rotate(5deg)}30%{transform:rotate(-9deg)}60%{transform:rotate(7deg)}100%{transform:rotate(5deg)}}
  .yt-card__type{font-size:14px;font-weight:600;color:#3E5168;margin-top:6px}
  .yt-card__title{font-size:16px;font-weight:600;line-height:1.3}
  .yt-add{margin-top:6px;min-height:44px;width:100%;border-radius:8px;border:2px solid var(--ink);background:#fff;color:var(--ink);font-family:inherit;font-weight:600;font-size:14px;cursor:pointer;transition:background .2s,color .2s}
  #yt-{{ section.id }} .yt-add:hover{background:var(--ink);color:#fff}
  #yt-{{ section.id }} .yt-add[data-state="added"]{background:var(--leaf);border-color:var(--leaf);color:#fff}
  .yt-bagnote{font-size:14px;font-weight:600;min-height:20px}
  .yt-bagnote a{text-decoration:underline !important}

  /* Store */
  .yt-store{background:#EAF5FC;margin-top:56px;padding:64px 0}
  .yt-store__in{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:stretch}
  .yt-store dl{margin:24px 0 0;display:grid;grid-template-columns:auto 1fr;gap:10px 24px;font-size:16px;line-height:1.5}
  .yt-store dt{font-weight:700}
  .yt-store dd{margin:0}
  .yt-map{border-radius:6px;overflow:hidden;min-height:400px;border:3px solid var(--ink)}
  .yt-map iframe{width:100%;height:100%;min-height:400px;border:0;display:block}

  @media (max-width:990px){
    .yt-hero__in,.yt-store__in{grid-template-columns:1fr}
    .yt-fan{height:440px;max-width:520px}
    .yt-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .yt-shelf__text{display:none}
  }
  @media (max-width:600px){
    .yt-wrap{padding:0 18px}
    .yt-hero__in{padding-top:48px;padding-bottom:56px}
    .yt-fan{height:360px}
    .yt-shelf{height:96px;padding:0 18px}
    .yt-shelf__img{width:96px;height:120px;right:18px;top:10px;transform:rotate(5deg)}
    .yt-shelf:hover{height:96px}
    .yt-reel{width:170px}
    .yt-grid{gap:28px 14px}
    .yt-card__title{font-size:16px}
    .yt-tag{font-size:15px;padding:14px 10px 8px}
  }
  @media (prefers-reduced-motion:reduce){
    .yt-thread .t-main,.yt-thread .t-red{animation:none;stroke-dashoffset:0}
    .yt-print,.yt-sticker{animation:none;opacity:1;transform:rotate(var(--r,0))}
    .yt-sticker{transform:rotate(-3deg)}
    .yt-track{animation:none}
    .yt-reels .yt-viewport{overflow-x:auto}
    .yt-shelf,.yt-shelf__img{transition:none}
    .yt-card:hover .yt-tag{animation:none}
  }
</style>

<div id="yt-{{ section.id }}">
  <section class="yt-hero">
    <svg class="yt-thread" viewBox="0 0 1440 660" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path class="t-main" pathLength="1" d="M-60 590 C 110 560 170 420 290 430 C 410 440 390 590 300 592 C 210 594 220 470 360 446 C 520 420 600 548 720 500 C 860 444 830 286 726 286 C 622 286 640 436 806 424 C 970 412 1030 214 1170 192 C 1290 174 1334 290 1252 330 C 1170 370 1126 250 1268 196 C 1370 158 1430 140 1510 104"/>
      <path class="t-red" pathLength="1" d="M612 610 C 652 560 690 520 700 452"/>
    </svg>
    <div class="yt-wrap yt-hero__in">
      <div>
        <h1 class="yt-h1 yt-display">{{ s.hero_heading | newline_to_br }}</h1>
        {%- if s.hero_malayalam != blank -%}<div class="yt-sticker" lang="ml">{{ s.hero_malayalam }}</div>{%- endif -%}
        <p class="yt-lead">{{ s.hero_text }}</p>
        <div class="yt-ctas">
          <a class="yt-btn yt-btn--ink" href="{{ s.hero_link | default: routes.all_products_collection_url }}">{{ s.hero_button }}</a>
          <a class="yt-btn yt-btn--ghost" href="https://wa.me/{{ s.whatsapp }}">Order on WhatsApp</a>
        </div>
      </div>
      <div class="yt-fan" aria-hidden="true">
        {%- for k in (1..3) -%}
          {%- liquid
            case k
              when 1
                assign im = s.hero_img1
              when 2
                assign im = s.hero_img2
              when 3
                assign im = s.hero_img3
            endcase
          -%}
          <div class="yt-print"><span>{%- if im != blank -%}{{ im | image_url: width: 700 | image_tag: loading: 'eager' }}{%- else -%}{{ 'apparel-' | append: k | placeholder_svg_tag }}{%- endif -%}</span></div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="yt-shelves" aria-labelledby="yt-shelves-{{ section.id }}">
    <div class="yt-wrap yt-shelfhead">
      <h2 class="yt-h2 yt-display" id="yt-shelves-{{ section.id }}">{{ s.shelves_heading }}</h2>
      <p>{{ s.shelves_text }}</p>
    </div>
    <div>
      {%- for k in (1..5) -%}
        {%- liquid
          case k
            when 1
              assign b_t = s.b1_title
              assign b_x = s.b1_text
              assign b_i = s.b1_image
              assign b_l = s.b1_link
            when 2
              assign b_t = s.b2_title
              assign b_x = s.b2_text
              assign b_i = s.b2_image
              assign b_l = s.b2_link
            when 3
              assign b_t = s.b3_title
              assign b_x = s.b3_text
              assign b_i = s.b3_image
              assign b_l = s.b3_link
            when 4
              assign b_t = s.b4_title
              assign b_x = s.b4_text
              assign b_i = s.b4_image
              assign b_l = s.b4_link
            when 5
              assign b_t = s.b5_title
              assign b_x = s.b5_text
              assign b_i = s.b5_image
              assign b_l = s.b5_link
          endcase
        -%}
        <a class="yt-shelf" href="{{ b_l | default: routes.all_products_collection_url }}">
          <span class="yt-shelf__name yt-display">{{ b_t }}</span>
          <span class="yt-shelf__text">{{ b_x }}</span>
          <span class="yt-shelf__img" aria-hidden="true">{%- if b_i != blank -%}{{ b_i | image_url: width: 400 | image_tag: loading: 'lazy' }}{%- endif -%}</span>
        </a>
      {%- endfor -%}
    </div>
  </section>

  <section class="yt-reels" aria-labelledby="yt-reels-{{ section.id }}">
    <div class="yt-wrap yt-reels__head">
      <h2 class="yt-h2 yt-display" id="yt-reels-{{ section.id }}">{{ s.reels_heading }}</h2>
      <a href="{{ s.instagram_url }}">@{{ s.instagram_handle }}</a>
    </div>
    <div class="yt-viewport">
      <div class="yt-track">
        {%- for pass in (1..2) -%}
          {%- for k in (1..9) -%}
            {%- liquid
              case k
                when 1
                  assign im = s.r1
                when 2
                  assign im = s.r2
                when 3
                  assign im = s.r3
                when 4
                  assign im = s.r4
                when 5
                  assign im = s.r5
                when 6
                  assign im = s.r6
                when 7
                  assign im = s.r7
                when 8
                  assign im = s.r8
                when 9
                  assign im = s.r9
              endcase
            -%}
            {%- if im != blank -%}
              <a class="yt-reel" href="{{ s.instagram_url }}" {% if pass == 2 %}aria-hidden="true" tabindex="-1"{% else %}aria-label="Open Instagram"{% endif %}>{{ im | image_url: width: 460 | image_tag: loading: 'lazy', alt: '' }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="yt-products" aria-labelledby="yt-prod-{{ section.id }}">
    <div class="yt-wrap">
      <div class="yt-shelfhead" style="margin-bottom:0">
        <h2 class="yt-h2 yt-display" id="yt-prod-{{ section.id }}">{{ s.products_heading }}</h2>
        <a class="yt-btn yt-btn--ghost" href="{{ s.products_collection.url | default: routes.all_products_collection_url }}">See all</a>
      </div>
      <div class="yt-grid">
        {%- assign col = s.products_collection -%}
        {%- if col != blank and col.products_count > 0 -%}
          {%- for product in col.products limit: s.products_limit -%}
            {%- assign v = product.selected_or_first_available_variant -%}
            <div class="yt-card">
              <a class="yt-card__img" href="{{ product.url }}">
                {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}
                {%- if product.price > 0 -%}<span class="yt-tag">{{ product.price | money_without_trailing_zeros }}</span>{%- endif -%}
              </a>
              <span class="yt-card__type">{{ product.type }}</span>
              <a class="yt-card__title" href="{{ product.url }}">{{ product.title }}</a>
              {%- if product.available and product.price > 0 -%}
                <form action="{{ routes.cart_add_url }}" method="post" class="yt-addform">
                  <input type="hidden" name="id" value="{{ v.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button class="yt-add" type="submit">Add to bag</button>
                  <div class="yt-bagnote" aria-live="polite"></div>
                </form>
              {%- else -%}
                <a class="yt-add" href="{{ product.url }}" style="display:flex;align-items:center;justify-content:center">See details</a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>

  <section class="yt-store" id="yt-store-{{ section.id }}">
    <div class="yt-wrap yt-store__in">
      <div>
        <h2 class="yt-h2 yt-display">{{ s.store_heading }}</h2>
        <dl>
          <dt>Where</dt><dd>{{ s.store_address | newline_to_br }}</dd>
          <dt>When</dt><dd>{{ s.store_hours }}</dd>
          <dt>Call</dt><dd>{{ s.phones }}</dd>
        </dl>
        <div class="yt-ctas">
          <a class="yt-btn yt-btn--leaf" href="https://wa.me/{{ s.whatsapp }}">Chat on WhatsApp</a>
          <a class="yt-btn yt-btn--ink" href="https://maps.google.com/?q={{ s.map_query | url_encode }}" target="_blank" rel="noopener">Get directions</a>
        </div>
      </div>
      <div class="yt-map"><iframe title="Map showing the Yathra store" loading="lazy" src="https://maps.google.com/maps?q={{ s.map_query | url_encode }}&output=embed"></iframe></div>
    </div>
  </section>
</div>

<script>
  (function(){
    if (window.__ytCartBound) return;
    window.__ytCartBound = true;
    document.addEventListener('submit', function(e){
      var form = e.target;
      if (!form || !form.classList || !form.classList.contains('yt-addform')) return;
      e.preventDefault();
      var btn = form.querySelector('.yt-add'), note = form.querySelector('.yt-bagnote');
      btn.disabled = true; btn.textContent = 'Adding…';
      fetch((window.Shopify && Shopify.routes ? Shopify.routes.root : '/') + 'cart/add.js', {method:'POST', headers:{'Accept':'application/json'}, body:new FormData(form)})
        .then(function(r){ if(!r.ok) throw r; return r.json(); })
        .then(function(){
          btn.dataset.state = 'added'; btn.textContent = 'Added to bag';
          note.innerHTML = '<a href="{{ routes.cart_url }}">View bag</a>';
          document.dispatchEvent(new CustomEvent('cart:update', {bubbles:true}));
        })
        .catch(function(){ btn.textContent = 'Add to bag'; note.textContent = 'Could not add. Pick a size on the product page.'; })
        .finally(function(){ btn.disabled = false; });
    });
  })();
</script>

{% schema %}
{
  "name": "Yathra Thread",
  "tag": "section",
  "class": "yathra-thread",
  "settings": [
    { "type": "header", "content": "Fonts & colours" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "poppins_n6" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "poppins_n4" },
    { "type": "color", "id": "sky", "label": "Brand blue", "default": "#3EA6E6" },
    { "type": "color", "id": "red", "label": "Brand red", "default": "#E0262D" },
    { "type": "color", "id": "ink", "label": "Text colour", "default": "#13233A" },
    { "type": "color", "id": "shelf1_color", "label": "Shelf 1 colour", "default": "#3EA6E6" },
    { "type": "color", "id": "shelf2_color", "label": "Shelf 2 colour", "default": "#13233A" },
    { "type": "color", "id": "shelf3_color", "label": "Shelf 3 colour", "default": "#EAF5FC" },
    { "type": "color", "id": "shelf4_color", "label": "Shelf 4 colour", "default": "#E0262D" },
    { "type": "color", "id": "shelf5_color", "label": "Shelf 5 colour", "default": "#F4F7FA" },
    { "type": "header", "content": "Hero" },
    { "type": "textarea", "id": "hero_heading", "label": "Heading", "default": "Ten years of\ndressing Arookutty's\nfamilies." },
    { "type": "text", "id": "hero_malayalam", "label": "Malayalam tagline", "default": "നമ്മുടെ സ്വന്തം തുണിക്കട" },
    { "type": "textarea", "id": "hero_text", "label": "Text", "default": "Shirts, salwars, kurta sets and party frocks for everyone at home. Order here, or walk in at Galleria, Vaduthala Junction." },
    { "type": "text", "id": "hero_button", "label": "Button label", "default": "Shop new arrivals" },
