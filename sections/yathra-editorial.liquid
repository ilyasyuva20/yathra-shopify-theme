                assign im = s.ig3
              when 4
                assign im = s.ig4
              when 5
                assign im = s.ig5
              when 6
                assign im = s.ig6
            endcase
          -%}
          <a href="{{ s.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram post {{ k }}">{%- if im != blank -%}{{ im | image_url: width: 400 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</a>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

<script>
  (function(){
    function initHero(root){
      var hero = root.querySelector('[data-ye-hero]'); if (!hero || hero.__ye) return; hero.__ye = true;
      var slides = [].slice.call(hero.querySelectorAll('[data-ye-slide]')); if (!slides.length) return;
      var dotsBox = hero.querySelector('[data-ye-dots]'), num = hero.querySelector('[data-ye-num]'), total = hero.querySelector('[data-ye-total]');
      var i = 0, timer = null, delay = parseInt(hero.dataset.delay,10) || 6000, busy = false;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var pad = function(n){ return (n < 10 ? '0' : '') + n; };
      if (total) total.textContent = pad(slides.length);
      slides.forEach(function(sl){
        var h = sl.querySelector('.ye-slide__title'); if (!h || h.__split) return; h.__split = true;
        var words = h.textContent.trim().split(/\s+/);
        h.setAttribute('aria-label', h.textContent.trim());
        h.innerHTML = words.map(function(w, n){ return '<span class="ye-w" aria-hidden="true"><span style="--i:' + n + '">' + w.replace(/</g,'&lt;') + '</span></span>'; }).join(' ');
      });
      var dots = slides.map(function(_, n){
        var hit = document.createElement('button'); hit.type='button'; hit.className='ye-dot-hit'; hit.setAttribute('aria-label','Show slide '+(n+1));
        var d = document.createElement('span'); d.className='ye-dot'; hit.appendChild(d);
        hit.addEventListener('click', function(){ go(n); });
        dotsBox.appendChild(hit); return d;
      });
      function setNum(n){
        if (!num) return;
        var old = num.firstElementChild, nu = document.createElement('span'); nu.textContent = pad(n+1);
        nu.style.transform = 'translateY(100%)'; num.appendChild(nu);
        requestAnimationFrame(function(){ requestAnimationFrame(function(){ old.style.transform='translateY(-100%)'; nu.style.transform='translateY(-100%)'; }); });
        setTimeout(function(){ if (old.parentNode) old.remove(); nu.style.transition='none'; nu.style.transform='none'; void nu.offsetWidth; nu.style.transition=''; }, 950);
      }
      function go(n){
        n = (n + slides.length) % slides.length; if (n === i || busy) return;
        busy = true;
        var prev = slides[i];
        slides.forEach(function(s){ s.classList.remove('is-leaving'); });
        prev.classList.remove('is-active'); prev.classList.add('is-leaving');
        dots[i].classList.remove('is-active');
        i = n;
        void slides[i].offsetWidth;
        slides[i].classList.add('is-active'); void dots[i].offsetWidth; dots[i].classList.add('is-active');
        setNum(i);
        setTimeout(function(){ prev.classList.remove('is-leaving'); busy = false; }, reduce ? 0 : 1200);
        restart();
      }
      function restart(){ clearTimeout(timer); if (!reduce && slides.length > 1 && !hero.classList.contains('is-paused')) timer = setTimeout(function(){ go(i+1); }, delay); }
      dots[0].classList.add('is-active');
      hero.querySelector('[data-ye-prev]').addEventListener('click', function(){ go(i-1); });
      hero.querySelector('[data-ye-next]').addEventListener('click', function(){ go(i+1); });
      hero.addEventListener('mouseenter', function(){ hero.classList.add('is-paused'); clearTimeout(timer); });
      hero.addEventListener('mouseleave', function(){ hero.classList.remove('is-paused'); hero.style.setProperty('--mx',0); hero.style.setProperty('--my',0); restart(); });
      hero.addEventListener('focusin', function(){ hero.classList.add('is-paused'); clearTimeout(timer); });
      if (!reduce && window.matchMedia('(hover: hover) and (pointer: fine)').matches){
        var raf = null;
        hero.addEventListener('mousemove', function(e){
          if (raf) return;
          raf = requestAnimationFrame(function(){
            var r = hero.getBoundingClientRect();
            hero.style.setProperty('--mx', (((e.clientX - r.left) / r.width) * 2 - 1).toFixed(3));
            hero.style.setProperty('--my', (((e.clientY - r.top) / r.height) * 2 - 1).toFixed(3));
            raf = null;
          });
        });
      }
      restart();
    }
    function initRails(root){
      root.querySelectorAll('[data-ye-rail]').forEach(function(rail){
        if (rail.__ye) return; rail.__ye = true;
        var sec = rail.closest('section'), prev = sec.querySelector('[data-ye-railprev]'), next = sec.querySelector('[data-ye-railnext]');
        function step(){ return rail.clientWidth * 0.9; }
        function update(){ prev.disabled = rail.scrollLeft <= 4; next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 4; }
        prev.addEventListener('click', function(){ rail.scrollBy({left:-step()}); });
        next.addEventListener('click', function(){ rail.scrollBy({left:step()}); });
        rail.addEventListener('scroll', update, {passive:true}); update();
      });
    }
    function initReveal(root){
      var els = root.querySelectorAll('[data-ye-reveal]:not(.is-in)');
      if (!('IntersectionObserver' in window)) { els.forEach(function(e){ e.classList.add('is-in'); }); return; }
      var io = new IntersectionObserver(function(entries){ entries.forEach(function(en){ if (en.isIntersecting){ en.target.classList.add('is-in'); io.unobserve(en.target); } }); }, {rootMargin:'0px 0px -8% 0px'});
      els.forEach(function(e){ io.observe(e); });
    }
    function init(root){ initHero(root); initRails(root); initReveal(root); }
    var me = document.getElementById('ye-{{ section.id }}'); if (me) init(me);
    if (!window.__yeBound){
      window.__yeBound = true;
      document.addEventListener('shopify:section:load', function(e){ var r = e.target.querySelector('[id^="ye-"]'); if (r) init(r); });
      document.addEventListener('submit', function(e){
        var form = e.target;
        if (!form || !form.classList || !form.classList.contains('ye-addform')) return;
        e.preventDefault();
        var btn = form.querySelector('button'); btn.disabled = true; btn.textContent = 'Adding…';
        fetch((window.Shopify && Shopify.routes ? Shopify.routes.root : '/') + 'cart/add.js', {method:'POST', headers:{'Accept':'application/json'}, body:new FormData(form)})
          .then(function(r){ if(!r.ok) throw r; return r.json(); })
          .then(function(){ btn.dataset.state='added'; btn.textContent='Added to bag'; document.dispatchEvent(new CustomEvent('cart:update',{bubbles:true})); setTimeout(function(){ btn.dataset.state=''; btn.textContent='Add to bag'; }, 2500); })
          .catch(function(){ btn.textContent='Choose size on product page'; })
          .finally(function(){ btn.disabled=false; });
      });
    }
  })();
</script>

