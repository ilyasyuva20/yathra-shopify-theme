      <div class="ye-head">
        <div><h2>{{ s.ig_heading }}</h2><p>@{{ s.instagram_handle }}</p></div>
        <a class="ye-viewall" href="{{ s.instagram_url }}" target="_blank" rel="noopener">Follow us</a>
