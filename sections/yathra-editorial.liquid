{%- comment -%} Yathra · Editorial homepage {%- endcomment -%}
{%- assign s = section.settings -%}
{{ 'https://fonts.googleapis.com/css2?family=Noto+Sans+Malayalam:wght@700&display=swap' | stylesheet_tag }}
<style>
  {{ s.heading_font | font_face: font_display: 'swap' }}
  {{ s.body_font | font_face: font_display: 'swap' }}
  {%- assign body_bold = s.body_font | font_modify: 'weight', 'bold' -%}{{ body_bold | font_face: font_display: 'swap' }}
  #ye-{{ section.id }}{--ink:#141414;--muted:#666;--line:#E6E6E6;--soft:#F5F6F7;--accent:{{ s.accent }};--sale:#C8202A;
    --hf:{{ s.heading_font.family }},{{ s.heading_font.fallback_families }};--hw:{{ s.heading_font.weight }};
    font-family:{{ s.body_font.family }},{{ s.body_font.fallback_families }};color:var(--ink);background:#fff;font-size:15px;line-height:1.55}
  #ye-{{ section.id }} *{box-sizing:border-box}
  #ye-{{ section.id }} a{color:inherit;text-decoration:none}
  #ye-{{ section.id }} img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 42%}
  #ye-{{ section.id }} h2,#ye-{{ section.id }} h3,#ye-{{ section.id }} .ye-hfont{font-family:var(--hf);font-weight:var(--hw);color:var(--ink);letter-spacing:0}
  #ye-{{ section.id }} :focus-visible{outline:2px solid var(--ink);outline-offset:3px}
  .ye-wrap{max-width:1400px;margin:0 auto;padding:0 40px}
  .ye-sec{padding:56px 0 0}
  .ye-head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:24px}
  #ye-{{ section.id }} .ye-head h2{margin:0;font-size:26px;line-height:1.2}
  .ye-head p{margin:4px 0 0;color:var(--muted);font-size:14px}
  .ye-viewall{font-size:14px;font-weight:600;border-bottom:1px solid currentColor;padding-bottom:1px;white-space:nowrap}

  /* Hero slider (vibrant style) */
  .ye-hero{position:relative;overflow:hidden;height:600px;background:{{ s.h1_bg }}}
  .ye-slide{position:absolute;inset:0;visibility:hidden;overflow:hidden;z-index:0;clip-path:inset(0 0 0 100%)}
  .ye-slide.is-active{visibility:visible;z-index:2;clip-path:inset(0 0 0 0);transition:clip-path 1.15s cubic-bezier(.77,0,.18,1)}
  .ye-slide.is-leaving{visibility:visible;z-index:1;clip-path:inset(0 0 0 0)}
  .ye-slide.is-leaving .ye-slide__in{transform:scale(.94) translateX(-4%);opacity:.35;transition:transform 1.15s cubic-bezier(.77,0,.18,1),opacity 1.15s ease}
  .ye-slide__in{transition:none}
  .ye-slide__in{position:relative;z-index:2;height:100%;max-width:1400px;margin:0 auto;padding:56px 56px 72px;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:48px;align-items:center}
  .ye-deco{position:absolute;inset:0;z-index:1;pointer-events:none;width:100%;height:100%}
  .ye-deco path,.ye-deco circle{fill:none;stroke-linecap:round}
  .ye-deco .d-ring{stroke:rgba(255,255,255,.22);stroke-width:26;stroke-dasharray:1;stroke-dashoffset:1}
  .ye-deco .d-red{stroke:#E0262D;stroke-width:22;stroke-dasharray:1;stroke-dashoffset:1}
  .ye-slide.is-active .d-ring{animation:ye-draw 2.2s cubic-bezier(.65,0,.35,1) .5s forwards}
  .ye-slide.is-active .d-red{animation:ye-draw 1.1s cubic-bezier(.65,0,.35,1) 1.3s forwards}
  @keyframes ye-draw{to{stroke-dashoffset:0}}
  .ye-pill{display:inline-flex;align-items:center;gap:8px;background:#fff;color:#0E2236;border-radius:999px;padding:8px 16px;font-size:13px;font-weight:700;letter-spacing:.05em;text-transform:uppercase}
  .ye-pill i{width:8px;height:8px;border-radius:50%;background:#E0262D;display:block}
  #ye-{{ section.id }} .ye-slide__title{margin:20px 0 0;color:#fff;font-weight:800;font-size:clamp(34px,4.4vw,62px);line-height:1.04;letter-spacing:-.01em;max-width:11em}
  .ye-ml{margin:16px 0 0;font-family:'Noto Sans Malayalam',sans-serif;font-weight:700;font-size:clamp(20px,2vw,28px);color:#FFE27A}
  .ye-slide__copy{margin:12px 0 0;font-size:17px;line-height:1.6;color:#fff;max-width:30em;font-weight:500}
  .ye-ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
  .ye-hbtn{position:relative;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 28px;border-radius:999px;font-weight:700;font-size:15px;transition:transform .4s cubic-bezier(.16,1,.3,1),box-shadow .4s ease}
  .ye-hbtn:hover{transform:translateY(-2px);box-shadow:0 14px 30px rgba(0,0,0,.2)}
  .ye-hbtn::after{content:"";position:absolute;inset:0;background:linear-gradient(105deg,transparent 30%,rgba(255,255,255,.35) 50%,transparent 70%);transform:translateX(-120%);transition:transform .8s cubic-bezier(.16,1,.3,1)}
  .ye-hbtn:hover::after{transform:translateX(120%)}
  #ye-{{ section.id }} .ye-hbtn--dark{background:#0E2236;color:#fff}
  #ye-{{ section.id }} .ye-hbtn--light{background:#fff;color:#0E2236}
  .ye-txt > *{opacity:0;transform:translateY(26px);transition:opacity .9s ease,transform 1.1s cubic-bezier(.16,1,.3,1)}
  .ye-slide.is-active .ye-txt > *{opacity:1;transform:none}
  .ye-slide.is-active .ye-txt > *:nth-child(1){transition-delay:.45s}
  .ye-slide.is-active .ye-txt > *:nth-child(2){transition-delay:.5s;opacity:1;transform:none}
  .ye-slide.is-active .ye-txt > *:nth-child(3){transition-delay:1.05s}
  .ye-slide.is-active .ye-txt > *:nth-child(4){transition-delay:1.15s}
  .ye-slide.is-active .ye-txt > *:nth-child(5){transition-delay:1.25s}
  .ye-slide__title{opacity:1 !important;transform:none !important}
  .ye-w{display:inline-block;overflow:hidden;vertical-align:top;padding-bottom:.08em;margin-bottom:-.08em}
  .ye-w > span{display:inline-block;transform:translateY(110%);transition:transform 1s cubic-bezier(.16,1,.3,1);transition-delay:calc(.5s + var(--i) * .07s)}
  .ye-slide.is-active .ye-w > span{transform:none}
  .ye-collage{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:228px 228px;gap:16px}
  .ye-tile{position:relative;border-radius:26px;overflow:hidden;background:rgba(255,255,255,.2);display:block}
  .ye-pw{position:absolute;inset:-14px;display:block;transform:translate3d(calc(var(--mx,0) * -12px),calc(var(--my,0) * -10px),0);transition:transform .9s cubic-bezier(.16,1,.3,1)}
  .ye-tile img{transform:scale(1.14);transition:transform 9s cubic-bezier(.16,1,.3,1)}
  .ye-slide.is-active .ye-tile img{transform:scale(1)}
  .ye-collage{transform:translate3d(calc(var(--mx,0) * 10px),calc(var(--my,0) * 8px),0);transition:transform .9s cubic-bezier(.16,1,.3,1)}
  .ye-tile--big::after{content:"";position:absolute;inset:0;z-index:2;pointer-events:none;background:linear-gradient(105deg,rgba(255,255,255,0) 35%,rgba(255,255,255,.35) 50%,rgba(255,255,255,0) 65%);transform:translateX(-120%)}
  .ye-slide.is-active .ye-tile--big::after{animation:ye-sheen 1.6s cubic-bezier(.4,0,.2,1) 1.5s forwards}
  @keyframes ye-sheen{to{transform:translateX(120%)}}
  .ye-tile--big{grid-row:span 2;clip-path:inset(100% 0 0 0 round 26px);transition:clip-path 1.3s cubic-bezier(.77,0,.18,1) .35s}
  .ye-slide.is-active .ye-tile--big{clip-path:inset(0 0 0 0 round 26px)}
  .ye-tile--small{clip-path:inset(0 0 0 100% round 26px);transition:clip-path 1.2s cubic-bezier(.77,0,.18,1) .7s}
  .ye-slide.is-active .ye-tile--small{clip-path:inset(0 0 0 0 round 26px)}
  .ye-tile--offer{background:#E0262D;color:#fff;padding:22px;display:flex;flex-direction:column;justify-content:space-between;opacity:0;transform:translateY(40px);transition:opacity .9s ease 1s,transform 1.2s cubic-bezier(.16,1,.3,1) 1s}
  .ye-slide.is-active .ye-tile--offer{opacity:1;transform:none}
  #ye-{{ section.id }} .ye-tile--offer,#ye-{{ section.id }} .ye-tile--offer b{color:#fff}
  .ye-slide.is-active .ye-tile--offer .ye-float{animation:ye-float 6s ease-in-out 2.4s infinite}
  @keyframes ye-float{50%{transform:translateY(-4px)}}
  .ye-tile--offer small{font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
  .ye-tile--offer b{font-size:clamp(24px,2.4vw,34px);font-weight:800;line-height:1.05;display:block}
  .ye-tile--offer span{font-size:14px;font-weight:600;border-bottom:1px solid rgba(255,255,255,.7);align-self:flex-start}
  .ye-count{position:absolute;left:56px;bottom:22px;z-index:4;display:flex;align-items:center;gap:12px;color:#fff;font-size:13px;font-weight:600;letter-spacing:.08em}
  .ye-count__num{display:inline-block;height:1.2em;overflow:hidden;line-height:1.2}
  .ye-count__num span{display:block;transition:transform .9s cubic-bezier(.77,0,.18,1)}
  .ye-count i{display:block;width:40px;height:1px;background:rgba(255,255,255,.6)}
  .ye-dots{position:absolute;right:56px;bottom:18px;display:flex;gap:10px;z-index:4}
  .ye-dot{display:block;width:34px;height:4px;border-radius:4px;background:rgba(255,255,255,.35);position:relative;overflow:hidden}
  .ye-dot::after{content:"";position:absolute;inset:0;background:#fff;transform:scaleX(0);transform-origin:left}
  .ye-dot.is-active::after{animation:ye-progress var(--ye-delay,6s) linear forwards}
  .ye-hero.is-paused .ye-dot.is-active::after{animation-play-state:paused}
  @keyframes ye-progress{to{transform:scaleX(1)}}
  .ye-dot-hit{padding:14px 0;background:none;border:0;cursor:pointer}
  .ye-arrow{position:absolute;top:50%;z-index:4;width:46px;height:46px;margin-top:-23px;border-radius:50%;border:0;background:#fff;display:grid;place-items:center;cursor:pointer;box-shadow:0 6px 18px rgba(0,0,0,.18);opacity:0;transition:opacity .25s,transform .2s}
  .ye-arrow:hover{transform:scale(1.08)}
  .ye-hero:hover .ye-arrow,.ye-arrow:focus-visible{opacity:1}
  .ye-arrow--prev{left:16px}
  .ye-arrow--next{right:16px}
  .ye-btn{display:inline-flex;align-items:center;justify-content:center;align-self:flex-start;margin-top:28px;min-height:48px;padding:0 32px;background:var(--ink);color:#fff !important;font-size:14px;font-weight:600;letter-spacing:.02em;transition:background .2s}
  .ye-btn:hover{background:var(--accent)}

  /* Categories */
  .ye-cats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px}
  .ye-cat{display:block}
  .ye-cat__img{display:block;aspect-ratio:3/4;overflow:hidden;background:var(--soft)}
  .ye-cat__img img{transition:transform .6s cubic-bezier(.2,.7,.2,1)}
  .ye-cat:hover .ye-cat__img img{transform:scale(1.05)}
  .ye-cat__name{display:block;margin-top:12px;font-size:15px;font-weight:600}
  .ye-cat__sub{display:block;font-size:13px;color:var(--muted)}

  /* Product rail */
  .ye-railwrap{position:relative}
  .ye-rail{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 3*20px)/4);gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;padding-bottom:4px}
  .ye-rail::-webkit-scrollbar{display:none}
  .ye-railbtns{display:flex;gap:8px}
  .ye-railbtn{width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:#fff;display:grid;place-items:center;cursor:pointer;transition:border-color .2s,background .2s}
  .ye-railbtn:hover{border-color:var(--ink)}
  .ye-railbtn:disabled{opacity:.35;cursor:default}
  .ye-card{scroll-snap-align:start;display:flex;flex-direction:column;min-width:0}
  .ye-card__media{position:relative;display:block;aspect-ratio:3/4;overflow:hidden;background:var(--soft)}
  .ye-card__media img{transition:transform .7s cubic-bezier(.2,.7,.2,1),opacity .4s}
  .ye-card:hover .ye-card__media img{transform:scale(1.04)}
  .ye-card__media .ye-alt{position:absolute;inset:0;opacity:0}
  .ye-card:hover .ye-card__media .ye-alt{opacity:1}
  .ye-badge{position:absolute;top:12px;left:12px;background:#fff;font-size:12px;font-weight:600;padding:4px 10px}
  .ye-badge--sale{background:var(--sale);color:#fff}
  .ye-quick{position:absolute;left:12px;right:12px;bottom:12px;transform:translateY(calc(100% + 14px));transition:transform .35s cubic-bezier(.2,.7,.2,1)}
  .ye-card:hover .ye-quick,.ye-card:focus-within .ye-quick{transform:none}
  .ye-quick button{width:100%;min-height:44px;border:0;background:#fff;color:var(--ink);font:inherit;font-size:14px;font-weight:600;cursor:pointer;box-shadow:0 4px 16px rgba(0,0,0,.12);transition:background .2s,color .2s}
  .ye-quick button:hover{background:var(--ink);color:#fff}
  .ye-quick button[data-state="added"]{background:var(--accent);color:#fff}
  .ye-card__vendor{margin-top:12px;font-size:12px;color:var(--muted)}
  .ye-card__title{margin-top:2px;font-size:14px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .ye-card__price{margin-top:6px;font-size:15px;font-weight:700}
  .ye-card__price s{font-weight:400;color:var(--muted);margin-left:6px;font-size:13px}
  .ye-card__price em{font-style:normal;color:var(--sale);font-size:13px;margin-left:6px;font-weight:600}

  /* Promo pair */
  .ye-promos{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .ye-promo{position:relative;display:block;aspect-ratio:4/3;overflow:hidden;background:var(--soft)}
  #ye-{{ section.id }} .ye-promo img{transition:transform .8s cubic-bezier(.2,.7,.2,1);object-position:50% 14%}
  .ye-promo:hover img{transform:scale(1.04)}
  .ye-promo::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.55),rgba(0,0,0,0) 55%)}
  .ye-promo__text{position:absolute;left:32px;right:32px;bottom:28px;z-index:1;color:#fff}
  #ye-{{ section.id }} .ye-promo__text h3{margin:0;font-size:28px;line-height:1.2;color:#fff}
  .ye-promo__text p{margin:6px 0 0;font-size:15px;opacity:.92}
  .ye-promo__text span{display:inline-block;margin-top:14px;font-size:14px;font-weight:600;border-bottom:1px solid #fff;padding-bottom:1px}

  /* Service bar */
  .ye-service{margin-top:64px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .ye-service__in{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
  .ye-service__item{display:flex;align-items:center;gap:14px;padding:26px 24px}
  .ye-service__item + .ye-service__item{border-left:1px solid var(--line)}
  .ye-service__item svg{flex:0 0 auto}
  .ye-service__item b{display:block;font-size:14px;font-weight:600}
  .ye-service__item small{display:block;font-size:13px;color:var(--muted)}

  /* Instagram */
  .ye-ig{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:4px}
  .ye-ig a{position:relative;display:block;aspect-ratio:1;overflow:hidden;background:var(--soft)}
  .ye-ig a::after{content:"";position:absolute;inset:0;background:rgba(0,0,0,0);transition:background .3s}
  .ye-ig a:hover::after{background:rgba(0,0,0,.18)}
  .ye-ig img{transition:transform .6s}
  .ye-ig a:hover img{transform:scale(1.05)}

  /* Reveal */
  .ye-reveal{opacity:0;transform:translateY(18px);transition:opacity .7s ease,transform .7s ease}
  .ye-reveal.is-in{opacity:1;transform:none}

  @media (max-width:1100px){
    .ye-rail{grid-auto-columns:calc((100% - 2*16px)/3);gap:16px}
    .ye-cats{grid-template-columns:repeat(5,minmax(160px,1fr));overflow-x:auto;scroll-snap-type:x mandatory}
    .ye-cat{scroll-snap-align:start}
  }
  @media (max-width:800px){
    .ye-wrap{padding:0 16px}
    .ye-hero{height:auto}
    .ye-slide{position:relative;display:none}
    .ye-slide.is-active{display:block}
    .ye-slide__in{grid-template-columns:1fr;gap:28px;padding:36px 16px 56px}
    .ye-collage{grid-template-rows:170px 170px;gap:10px}
    .ye-tile{border-radius:18px}
    .ye-dots{bottom:14px;right:16px}
    .ye-count{left:16px;bottom:18px}
    .ye-collage{transform:none}
    .ye-pw{transform:none}
    .ye-arrow{display:none}
    .ye-rail{grid-auto-columns:calc((100% - 12px)/2.15);gap:12px}
    .ye-quick{transform:none;left:8px;right:8px;bottom:8px}
    .ye-quick button{min-height:38px;font-size:13px}
    .ye-promos{grid-template-columns:1fr}
    .ye-service__in{grid-template-columns:1fr 1fr}
    .ye-service__item:nth-child(3){border-left:0}
    .ye-service__item:nth-child(n+3){border-top:1px solid var(--line)}
    .ye-ig{grid-template-columns:repeat(3,minmax(0,1fr))}
    #ye-{{ section.id }} .ye-head h2{font-size:21px}
  }
  @media (prefers-reduced-motion:reduce){
    .ye-slide,.ye-txt > *,.ye-tile,.ye-tile img,.ye-reveal,.ye-card__media img,.ye-cat__img img,.ye-promo img{transition:none !important;transform:none !important}
    .ye-reveal{opacity:1}
    .ye-dot.is-active::after{animation:none;transform:scaleX(1)}
    .ye-deco .d-ring,.ye-deco .d-red{animation:none !important;stroke-dashoffset:0}
    .ye-tile--big{clip-path:none}
    .ye-tile--small,.ye-tile--offer{opacity:1}
    .ye-float{animation:none !important}
    .ye-w > span{transform:none !important;transition:none !important}
    .ye-slide.is-active,.ye-tile--small{clip-path:none !important}
    .ye-tile--big::after{display:none}
    .ye-collage,.ye-pw{transform:none !important}
  }
</style>

<div id="ye-{{ section.id }}">
  {%- comment -%} Hero {%- endcomment -%}
  <section class="ye-hero" data-ye-hero data-delay="{{ s.hero_delay | times: 1000 }}" style="--ye-delay:{{ s.hero_delay }}s" aria-roledescription="carousel" aria-label="Featured collections">
    {%- for k in (1..3) -%}
      {%- liquid
        case k
          when 1
            assign h_label = s.h1_label
            assign h_title = s.h1_title
            assign h_text = s.h1_text
            assign h_btn = s.h1_button
            assign h_link = s.h1_link
            assign h_bg = s.h1_bg
            assign h_a = s.h1_img_a
            assign h_b = s.h1_img_b
            assign h_ol = s.h1_offer_label
            assign h_ot = s.h1_offer_title
          when 2
            assign h_label = s.h2_label
            assign h_title = s.h2_title
            assign h_text = s.h2_text
            assign h_btn = s.h2_button
            assign h_link = s.h2_link
            assign h_bg = s.h2_bg
            assign h_a = s.h2_img_a
            assign h_b = s.h2_img_b
            assign h_ol = s.h2_offer_label
            assign h_ot = s.h2_offer_title
          when 3
            assign h_label = s.h3_label
            assign h_title = s.h3_title
            assign h_text = s.h3_text
            assign h_btn = s.h3_button
            assign h_link = s.h3_link
            assign h_bg = s.h3_bg
            assign h_a = s.h3_img_a
            assign h_b = s.h3_img_b
            assign h_ol = s.h3_offer_label
            assign h_ot = s.h3_offer_title
        endcase
        assign h_url = h_link | default: routes.all_products_collection_url
      -%}
      {%- if h_title != blank -%}
        <div class="ye-slide{% if k == 1 %} is-active{% endif %}" data-ye-slide role="group" aria-roledescription="slide" aria-label="{{ k }} of 3" style="background:{{ h_bg }}">
          <svg class="ye-deco" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <circle class="d-ring" pathLength="1" cx="1280" cy="470" r="210"/>
            <path class="d-red" pathLength="1" d="M760 640 C 860 560 930 470 950 330"/>
          </svg>
          <div class="ye-slide__in">
            <div class="ye-txt">
              <span class="ye-pill"><i></i>{{ h_label }}</span>
              <h2 class="ye-slide__title">{{ h_title }}</h2>
              {%- if s.hero_ml != blank -%}<p class="ye-ml" lang="ml">{{ s.hero_ml }}</p>{%- endif -%}
              <p class="ye-slide__copy">{{ h_text }}</p>
              <div class="ye-ctas">
                <a class="ye-hbtn ye-hbtn--dark" href="{{ h_url }}">{{ h_btn }}</a>
                <a class="ye-hbtn ye-hbtn--light" href="{{ s.hero_store_link | default: '/pages/contact' }}">Visit our store</a>
              </div>
            </div>
            <div class="ye-collage">
              <a class="ye-tile ye-tile--big" href="{{ h_url }}" tabindex="-1" aria-hidden="true"><span class="ye-pw">{%- if h_a != blank -%}{{ h_a | image_url: width: 1000 | image_tag: loading: 'eager', alt: '' }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}</span></a>
              <a class="ye-tile ye-tile--small" href="{{ h_url }}" tabindex="-1" aria-hidden="true"><span class="ye-pw">{%- if h_b != blank -%}{{ h_b | image_url: width: 700 | image_tag: loading: 'eager', alt: '' }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag }}{%- endif -%}</span></a>
              <a class="ye-tile ye-tile--offer" href="{{ h_url }}"><small>{{ h_ol }}</small><span class="ye-float" style="border:0"><b>{{ h_ot }}</b></span><span>Shop now</span></a>
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
    <button class="ye-arrow ye-arrow--prev" type="button" data-ye-prev aria-label="Previous slide"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#141414" stroke-width="1.8" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
    <button class="ye-arrow ye-arrow--next" type="button" data-ye-next aria-label="Next slide"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#141414" stroke-width="1.8" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
