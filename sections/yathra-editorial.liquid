          {%- liquid
            case k
              when 1
                assign c_t = s.c1_title
                assign c_s = s.c1_sub
                assign c_i = s.c1_image
                assign c_l = s.c1_link
              when 2
                assign c_t = s.c2_title
                assign c_s = s.c2_sub
                assign c_i = s.c2_image
                assign c_l = s.c2_link
              when 3
                assign c_t = s.c3_title
                assign c_s = s.c3_sub
                assign c_i = s.c3_image
                assign c_l = s.c3_link
              when 4
                assign c_t = s.c4_title
                assign c_s = s.c4_sub
                assign c_i = s.c4_image
                assign c_l = s.c4_link
              when 5
                assign c_t = s.c5_title
                assign c_s = s.c5_sub
                assign c_i = s.c5_image
                assign c_l = s.c5_link
            endcase
          -%}
          <a class="ye-cat" href="{{ c_l | default: routes.all_products_collection_url }}">
            <span class="ye-cat__img">{%- if c_i != blank -%}{{ c_i | image_url: width: 600 | image_tag: loading: 'lazy', alt: c_t }}{%- else -%}{{ 'apparel-' | append: k | placeholder_svg_tag }}{%- endif -%}</span>
            <span class="ye-cat__name">{{ c_t }}</span>
            <span class="ye-cat__sub">{{ c_s }}</span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} Product rails {%- endcomment -%}
  {%- for r in (1..2) -%}
    {%- liquid
      if r == 1
        assign rc = s.rail1_collection
        assign rh = s.rail1_heading
        assign rp = s.rail1_text
      else
        assign rc = s.rail2_collection
        assign rh = s.rail2_heading
        assign rp = s.rail2_text
      endif
    -%}
    {%- if rc != blank and rc.products_count > 0 -%}
      <section class="ye-sec ye-reveal" data-ye-reveal>
        <div class="ye-wrap">
          <div class="ye-head">
            <div><h2>{{ rh }}</h2>{%- if rp != blank -%}<p>{{ rp }}</p>{%- endif -%}</div>
            <div style="display:flex;align-items:center;gap:20px">
              <a class="ye-viewall" href="{{ rc.url }}">View all</a>
              <div class="ye-railbtns">
                <button class="ye-railbtn" type="button" data-ye-railprev aria-label="Scroll back"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#141414" stroke-width="1.8" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
                <button class="ye-railbtn" type="button" data-ye-railnext aria-label="Scroll forward"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#141414" stroke-width="1.8" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
              </div>
            </div>
          </div>
          <div class="ye-rail" data-ye-rail>
            {%- for product in rc.products limit: 12 -%}
              {%- assign v = product.selected_or_first_available_variant -%}
              <div class="ye-card">
                <div class="ye-card__media">
                  <a href="{{ product.url }}" style="display:block;width:100%;height:100%" tabindex="-1" aria-hidden="true">
                    {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', alt: '', sizes: '(min-width: 1100px) 25vw, 50vw' }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}
                    {%- if product.media[1] -%}<span class="ye-alt">{{ product.media[1] | image_url: width: 700 | image_tag: loading: 'lazy', alt: '' }}</span>{%- endif -%}
                  </a>
                  {%- if product.compare_at_price > product.price -%}<span class="ye-badge ye-badge--sale">Sale</span>{%- elsif forloop.index <= 2 and r == 1 -%}<span class="ye-badge">New</span>{%- endif -%}
                  {%- if product.available and product.price > 0 -%}
                    <form action="{{ routes.cart_add_url }}" method="post" class="ye-quick ye-addform">
                      <input type="hidden" name="id" value="{{ v.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button type="submit">Add to bag</button>
                    </form>
                  {%- endif -%}
                </div>
                <span class="ye-card__vendor">{{ product.type | default: product.vendor }}</span>
                <a class="ye-card__title" href="{{ product.url }}">{{ product.title }}</a>
                <span class="ye-card__price">
                  {%- if product.price > 0 -%}{{ product.price | money_without_trailing_zeros }}{%- else -%}Price on request{%- endif -%}
                  {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money_without_trailing_zeros }}</s><em>{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}% off</em>{%- endif -%}
                </span>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </section>
    {%- endif -%}
    {%- if r == 1 -%}
      {%- comment -%} Promo pair between rails {%- endcomment -%}
      <section class="ye-sec ye-reveal" data-ye-reveal>
        <div class="ye-wrap ye-promos">
          <a class="ye-promo" href="{{ s.p1_link | default: routes.all_products_collection_url }}">
            {%- if s.p1_image != blank -%}{{ s.p1_image | image_url: width: 1100 | image_tag: loading: 'lazy', alt: s.p1_title }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}
            <span class="ye-promo__text"><h3>{{ s.p1_title }}</h3><p>{{ s.p1_text }}</p><span>Shop now</span></span>
          </a>
          <a class="ye-promo" href="{{ s.p2_link | default: routes.all_products_collection_url }}">
            {%- if s.p2_image != blank -%}{{ s.p2_image | image_url: width: 1100 | image_tag: loading: 'lazy', alt: s.p2_title }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag }}{%- endif -%}
            <span class="ye-promo__text"><h3>{{ s.p2_title }}</h3><p>{{ s.p2_text }}</p><span>Shop now</span></span>
          </a>
        </div>
      </section>
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} Service bar {%- endcomment -%}
  <section class="ye-service">
    <div class="ye-wrap ye-service__in">
      <div class="ye-service__item"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#141414" stroke-width="1.4" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="1.5"/><circle cx="12" cy="12" r="2.5"/><path d="M6 9v.01M18 15v.01"/></svg><span><b>Cash on delivery</b><small>Across Kerala</small></span></div>
      <div class="ye-service__item"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#141414" stroke-width="1.4" aria-hidden="true"><path d="M4 9h13l-3-3M20 15H7l3 3"/></svg><span><b>Easy exchange</b><small>At our Vaduthala store</small></span></div>
      <div class="ye-service__item"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#141414" stroke-width="1.4" aria-hidden="true"><path d="M3 9l2-5h14l2 5M3 9h18v11H3zM9 20v-6h6v6"/></svg><span><b>Store pickup</b><small>Galleria, Vaduthala Jn.</small></span></div>
      <div class="ye-service__item"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#141414" stroke-width="1.4" aria-hidden="true"><path d="M4 20l1.3-3.8A8 8 0 1 1 8 19z"/></svg><span><b>WhatsApp help</b><small><a href="https://wa.me/{{ s.whatsapp }}">Chat with us</a></small></span></div>
    </div>
